
#include <iostream>
#include <climits>
using namespace std;

#define MAX 20

void prims(int graph[MAX][MAX], int n)
{
    int parent[MAX], key[MAX];
    bool visited[MAX] = {false};

    for (int i = 0; i < n; i++)
        key[i] = INT_MAX;

    key[0] = 0;
    parent[0] = -1;

    int totalCost = 0;

    for (int count = 0; count < n; count++)
    {
        int minKey = INT_MAX;
        int u = -1;

        for (int v = 0; v < n; v++)
        {
            if (!visited[v] && key[v] < minKey)
            {
                minKey = key[v];
                u = v;
            }
        }

        if (u == -1)
        {
            cout << "Graph is disconnected!\n";
            return;
        }

        visited[u] = true;

        for (int v = 0; v < n; v++)
        {
            if (graph[u][v] != 0 &&
                !visited[v] &&
                graph[u][v] < key[v])
            {
                parent[v] = u;
                key[v] = graph[u][v];
            }
        }
    }

    cout << "\nEdge\tWeight\n";

    for (int i = 1; i < n; i++)
    {
        cout << parent[i] << " - " << i
             << "\t" << graph[i][parent[i]] << "\n";

        totalCost += graph[i][parent[i]];
    }

    cout << "Total cost of MST = " << totalCost << "\n";
}

int main()
{
    int graph[MAX][MAX], n;

    cout << "Enter number of vertices: ";
    cin >> n;

    if (n < 1 || n > MAX)
    {
        cout << "Invalid number of vertices!\n";
        return 0;
    }

    cout << "Enter adjacency matrix (0 for no edge):\n";

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            cin >> graph[i][j];
        }
    }

    prims(graph, n);

    return 0;
}
